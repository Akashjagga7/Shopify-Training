<header class="site-header" role="banner">
  <div class="container-fluid">
    <div class="row">
      <div class="cell">
        {%- render 'primary-nav' -%}
        <a href="javascript:void(0);" class="hamburger__menu">
          <span></span>
        </a>
      </div>
      <div class="cell">
        <div class="logo">
          <a class="logo__link" href="/">
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | img_url: '300x'}}" alt="True Botanicals">
            {%- else -%}
              {%- render 'site-logo' -%}
            {%- endif -%}
          </a>
        </div>
      </div>
      <div class="cell">
        {%- render 'secondary-nav' -%}
      </div>
    </div>
  </div>
</header>

{%- render 'mobile-navigation' -%}
{%- render 'search-window' -%}

{% schema %}
{
  "name":"Header",
  "settings":[
    {
        "type":"image_picker",
        "id":"logo",
        "label":"Logo image"
    },
    {
        "type":"link_list",
        "id":"menu",
        "label":"Primary Menu",
        "default":"main-menu"
    },
    {
      "type":"link_list",
      "id":"menu_right",
      "label":"Secondary Menu"
    },
    {
      "type":"image_picker",
      "id":"ad_image",
      "label":"Ad Image"
    },
    {
        "type":"text",
        "id":"ad_description",
        "label":"Ad Description"
    },
    {
      "type":"text",
      "id":"ad_button_text",
      "label":"Ad Button Text"
    },
    {
      "type":"url",
      "id":"ad_button_url",
      "label":"Ad Button Url"
    }
  ]
}
{% endschema %}

{% if template.name == 'index' %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "WebSite",
    "name": "{{ shop.name }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ shop.url }}/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    },
    "url": "{{ shop.url }}{{ page.url }}"
  }
</script>
{% endif %}