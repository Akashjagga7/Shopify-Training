{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_image = current_variant.featured_image | default: product.featured_image %}

<div class="row productDetail">
  <div class="col-6 productDetail__thumbs">
    <div class="product__thumbsSlider swiper">
      <div class="product__thumbs swiper-wrapper">
        {% for image in product.images %}
          <div class="product__thumbItems swiper-slide">
            <img src="{{ image.src | product_img_url: 'master' }}" class="product__thumbImg" />
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="product__mainSlider swiper">
      <div class="swiper-wrapper">
        {% for image in product.images %}
          <div class="product__image swiper-slide">
            {%- render 'responsive-image' with image: {{image.src | product_img_url: 'master'}}, image_class: "product__mainImg", max_width: 600, max_height: 800 -%}
          </div>
        {% endfor %}  
      </div>
    </div>
  </div>
  <div class="col-6 productDetail__imgOnly">
    <img src="{{ product.featured_image | product_img_url: 'large' }}" />
  </div>
  <div class="col-6">
    <div class="product-description">
      <h1>{{ product.title }}</h1>
      <div class="type"><span>Type:</span> {{ product.type }}</div>
      <div class="vendor"><span>Vendor:</span> {{ product.vendor }}</div>        
      <div class="description"> 
        {{ product.description }}
      </div>   

