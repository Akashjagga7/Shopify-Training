<section class="collection">
  <div class="collection__hero">
    <div class="row">
      <div class="collection__hero__content col-4">
        <h2 class="collection__hero__title">{{collection.title}}</h2>
        <p class="collection__hero__description">{{collection.description}}</p>
      </div>
      <div class="collection__hero__image col-8">
        {%- render 'responsive-image' with image: {{collection.featured_image}}, image_class: "collection__hero__image", max_width: 960, max_height: 424 -%}
      </div>
    </div>
  </div>
  <div class="collection__filters">
    <div class="container-fluid">
      <div class="row">
        <div class="collection__filters__wrapper col-9">
          <label class="filters__label">FILTER BY</label>
          <div class="custom__select">
            <span class="custom__select__default">{{collection.title}}</span>
            <ul class="custom__select__list">
              {% for collection in collections %}
                <li class="custom__select__item">{{collection.title | link_to: collection.url}}</li>
              {% endfor %}
            </ul>
          </div>
          <div class="custom__select">
            <span class="custom__select__default">{{ current_tags | default: "Tags"}}</span> 
            <ul class="custom__select__list">
              {% for product_tag in collection.all_tags %}
                <li class="custom__select__item">{{product_tag | link_to_tag: product_tag}}</li>
              {% endfor %}
            </ul>
          </div>
          <div class="custom__select">
              {%- assign prices = collection.metafields.custom_fields["price_filter"] | split: "," -%}
              <select id="filterProduct">
                {% for price in prices %}
                  <option value="{{price}}">{{price}}</option>
                {% endfor %}
              </select>
          </div>
        </div>
        <div class="collection__filters__sort col-3">
          <label class="filters__label">SORT BY</label>
          <div class="custom__select">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            {% for option in collection.sort_options %}
              {%if option.value == sort_by%}
                <span class="custom__select__default">{{option.name}}</span>
              {%endif%}
            {%endfor%}
            <ul class="custom__select__list">
              {% for option in collection.sort_options %}
                <li class="custom__select__item">
                  <a href="?sort_by={{option.value}}">{{ option.name }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>  
      </div>  
    </div>
  </div>
  <div class="collection__products">
    <div class="container-fluid">
      <div class="collection__products__count col-12">{{collection.products_count}} Items</div>
      {% if collection.products_count > 10 %}
        {% paginate collection.products by 10 %}
          <div class="row">
            {% for product in collection.products %}
              <div class="col-3">
                {% include 'product-grid' %}
              </div>
            {% endfor %}  
          </div>
          {% include 'pagination' %}
        {% endpaginate %}
      {%else%}
        <div class="row">
          {% for product in collection.products %}
            <div class="col-3">
              {% include 'product-grid' %}
            </div>
          {% endfor %}  
        </div>  
      {% endif %}  
    </div>
  </div>
  <div class="collection__products">
    <div class="container-fluid">
      <h2>Collection Products from storefront Api</h2>
      <div class="row" id="row"></div> 
    </div>
  </div>
  {% section 'about-collection' %}


  <div class="collectionProductVue">
    <collection></collection>
  </div>
</section> 

<script id="collection-data" type="application/json">
{
  "title": "{{collection.title}}",
  "description": "{{collection.description}}",
  "featureImage": "{{collection.featured_image | img_url: 'master'}}",
  "url": "{{collection.url}}",
  "product": [
    {% for product in collection.products %}
      {
        "title": "{{product.title}}",
        "desc": "{{product.description | truncate: 30}}",
        "url": "{{product.url}}",
        "image": "{{product.featured_image | img_url: 'master'}}",
        "price": "{{product.first_available_variant.price | money_without_trailing_zeros}}",
        "tags": [
          {% for tag in product.tags %} 
          "{{tag}}"
          {% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}  
    {% endfor %}
  ],
  "length": {{collection.products_count}},
  "col": [
    {% for col in collections %}
      {
        "title": "{{col.title}}",
        "url": "{{col.url}}"
      }{% unless forloop.last %},{% endunless %}  
    {% endfor %}
  ],
  "tag": [
    {% for tag in collection.all_tags %}
      {
        "productTag": "{{tag}}"
      }{% unless forloop.last %},{% endunless %}  
    {% endfor %}
  ],
  "currentTag": "{{ current_tags | default: "Tags"}}",
  "sortOption": [
    {% for sortOption in collection.sort_options %}
      {
        "name": "{{sortOption.name}}",
        "value": "{{sortOption.value}}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}  
  ],
  "defaultSort": "{{collection.sort_by | default: collection.default_sort_by}}",
  "priceFilter": [
    {% assign prices = collection.metafields.custom_fields['price_filter'] | split: ',' %}
    {% for price in prices %} 
      {
        "val": "{{price}}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>
