{%- style -%}
  #shopify-section-{{ section.id }} {
    --category-columns: {{ section.settings.columns }};
    --category-gap: {{ section.settings.columns_gap }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --category-columns: {{ section.settings.mobile_columns }};
    }
  }
{%- endstyle -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    category-slider
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <slideshow-component class="category-slider__wrapper" auto-hide-controls>
    <div class="category-slider__header">
      {%- if section.settings.heading != blank -%}
        <p class="category-slider__heading">{{ section.settings.heading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_arrows -%}
        {%- render 'slideshow-arrows', icon_style: section.settings.icons_style, icon_shape: 'none', class: 'category-slider__arrows' -%}
      {%- endif -%}
    </div>
    <slideshow-container ref="slideshowContainer">
      <slideshow-slides tabindex="-1" ref="scroller">
        {%- for block in section.blocks -%}
          <div class="category-card color-{{ section.settings.card_color_scheme }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="category-card__link" aria-label="{{ block.settings.title | escape }}"></a>
            {%- endif -%}
            <div class="category-card__image-wrapper">
              {%- if block.settings.image != blank -%}
                {%- assign sizes_val = '(min-width: 750px) calc((100vw - 128px - (' | append: section.settings.columns | append: ' - 1) * ' | append: section.settings.columns_gap | append: 'px) / ' | append: section.settings.columns | append: '), calc((100vw - 32px - (' | append: section.settings.mobile_columns | append: ' - 1) * ' | append: section.settings.columns_gap | append: 'px) / ' | append: section.settings.mobile_columns | append: ')' -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: sizes_val,
                    widths: '145,200,284,375,500,600',
                    loading: 'lazy',
                    class: 'category-card__image',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'category-card__image category-card__image--placeholder' }}
              {%- endif -%}
            </div>
            <div class="category-card__details">
              {%- if block.settings.title != blank -%}
                <p class="category-card__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="category-card__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </slideshow-slides>
    </slideshow-container>
  </slideshow-component>
</div>

{% stylesheet %}
  .category-slider__wrapper {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .category-slider__header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
  }

  .category-slider__heading {
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .category-slider__arrows {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .category-slider slideshow-slides {
    gap: var(--category-gap);
  }

  .category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 16px;
    flex: 0 0 calc((100% - (var(--category-columns) - 1) * var(--category-gap)) / var(--category-columns));
    scroll-snap-align: start;
    overflow: hidden;
  }

  .category-card__link {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised, 1);
  }

  .category-card__image-wrapper {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .category-card__image--placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-card__details {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-inline: 16px;
  }

  .category-card__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-foreground);
    margin: 0;
  }

  .category-card__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .category-slider__wrapper {
      gap: 24px;
    }

    .category-slider__arrows {
      display: none;
    }

    .category-card__title {
      font-family: var(--font-body--family);
      font-size: 16px;
      line-height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.category_slider",
  "tag": "section",
  "class": "category-slider-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by category"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:settings.card_color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:settings.show_arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "category-card",
      "name": "t:names.category_card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title",
          "default": "Category title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:settings.description",
          "default": "Lorem ipsum dolor sit amet"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.category_slider",
      "blocks": [
        {
          "type": "category-card",
          "settings": {
            "title": "Shirts & Button Downs",
            "description": "Lorem ipsum dolor sit amet"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Long Sleeve Tees",
            "description": "Lorem ipsum dolor sit amet"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Sweatshirts & Hoodies",
            "description": "Lorem ipsum dolor sit amet"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Pants & Denim",
            "description": "Lorem ipsum dolor sit amet"
          }
        },
        {
          "type": "category-card",
          "settings": {
            "title": "Shorts",
            "description": "Lorem ipsum dolor sit amet"
          }
        }
      ]
    }
  ]
}
{% endschema %}
