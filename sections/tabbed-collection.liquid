{% liquid
  assign heading = section.settings.heading
  assign columns = section.settings.columns
  assign mobile_columns = section.settings.mobile_columns
  assign products_per_tab = section.settings.products_per_tab
%}

<div
  id="section-{{ section.id }}"
  class="tabbed-collection color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="tabbed-collection__container page-width">
    {% if heading != blank %}
      <h2 class="tabbed-collection__heading">{{ heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="tabbed-collection__tabs" role="tablist">
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            <button
              class="tabbed-collection__tab{% if forloop.first %} tabbed-collection__tab--active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="tabbed-collection__panel-{{ block.id }}"
              id="tabbed-collection__tab-{{ block.id }}"
              data-tab-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <div
            class="tabbed-collection__panel{% if forloop.first %} tabbed-collection__panel--active{% endif %}"
            role="tabpanel"
            id="tabbed-collection__panel-{{ block.id }}"
            aria-labelledby="tabbed-collection__tab-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {% if block.settings.collection != blank %}
              <div class="tabbed-collection__grid" style="--columns: {{ columns }}; --mobile-columns: {{ mobile_columns }};">
                {% for product in block.settings.collection.products limit: products_per_tab %}
                  <div class="tabbed-collection__grid-item">
                    {% render 'product-card', product: product %}
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <p class="tabbed-collection__empty">{{ 'sections.collection_list.no_collections' | t | default: 'No collection selected' }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const section = document.getElementById('section-{{ section.id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.tabbed-collection__tab');
    const panels = section.querySelectorAll('.tabbed-collection__panel');

    for (const tab of tabs) {
      tab.addEventListener('click', function() {
        const index = parseInt(this.dataset.tabIndex, 10);

        for (const t of tabs) {
          t.classList.remove('tabbed-collection__tab--active');
          t.setAttribute('aria-selected', 'false');
        }
        for (const p of panels) {
          p.classList.remove('tabbed-collection__panel--active');
          p.hidden = true;
        }

        this.classList.add('tabbed-collection__tab--active');
        this.setAttribute('aria-selected', 'true');
        panels[index].classList.add('tabbed-collection__panel--active');
        panels[index].hidden = false;
      });
    }
  })();
</script>

{% stylesheet %}
  .tabbed-collection {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
  }

  .tabbed-collection__container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tabbed-collection__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.5rem;
    line-height: 2rem;
    margin: 0;
  }

  .tabbed-collection__tabs {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    border-bottom: 1px solid var(--color-border);
    padding-block-end: 0;
  }

  .tabbed-collection__tabs::-webkit-scrollbar {
    display: none;
  }

  .tabbed-collection__tab {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1rem;
    padding: 8px 4px 12px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    color: var(--color-foreground);
    opacity: 0.6;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .tabbed-collection__tab:hover {
    opacity: 0.8;
  }

  .tabbed-collection__tab--active {
    opacity: 1;
    border-bottom-color: var(--color-foreground);
  }

  .tabbed-collection__panel {
    display: none;
  }

  .tabbed-collection__panel--active {
    display: block;
  }

  .tabbed-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--mobile-columns, 2), 1fr);
    gap: 24px 8px;
  }

  @media screen and (min-width: 750px) {
    .tabbed-collection__heading {
      font-size: 2rem;
      line-height: 2.5rem;
    }

    .tabbed-collection__grid {
      grid-template-columns: repeat(var(--columns, 4), 1fr);
      gap: 24px 8px;
    }
  }

  .tabbed-collection__empty {
    text-align: center;
    color: var(--color-foreground);
    opacity: 0.6;
    padding: 24px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tabbed_collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Men's Bestsellers"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "t:settings.products_per_tab",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.tab_label",
          "default": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.tabbed_collection",
      "settings": {
        "heading": "Men's Bestsellers"
      },
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "label": "BOTTOMS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "TOPS"
          }
        },
        {
          "type": "tab",
          "settings": {
            "label": "ACCESSORIES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
