{% liquid
  assign heading = section.settings.heading
  assign cta_text = section.settings.cta_text
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

<div
  id="section-{{ section.id }}"
  class="sustainability-stats color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="sustainability-stats__wrapper">
    {% if section.settings.background_image != blank %}
      <div class="sustainability-stats__background">
        {{
          section.settings.background_image
          | image_url: width: section.settings.background_image.width
          | image_tag:
            sizes: '100vw',
            widths: '375,750,1100,1500,1780,2000',
            loading: 'lazy',
            class: 'sustainability-stats__bg-image',
            alt: section.settings.background_image.alt
        }}
      </div>
      <div class="sustainability-stats__overlay" style="--overlay-opacity: {{ overlay_opacity }};"></div>
    {% endif %}

    <div class="sustainability-stats__content page-width">
      {% if heading != blank %}
        <h2 class="sustainability-stats__heading">{{ heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="sustainability-stats__grid">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="sustainability-stats__card" {{ block.shopify_attributes }}>
                {% if block.settings.stat_icon != blank %}
                  <div class="sustainability-stats__icon">
                    {{
                      block.settings.stat_icon
                      | image_url: width: 120
                      | image_tag:
                        loading: 'lazy',
                        class: 'sustainability-stats__icon-img',
                        alt: block.settings.stat_icon.alt
                    }}
                  </div>
                {% endif %}
                {% if block.settings.stat_number != blank %}
                  <p class="sustainability-stats__number">{{ block.settings.stat_number | escape }}</p>
                {% endif %}
                {% if block.settings.stat_label != blank %}
                  <p class="sustainability-stats__label">{{ block.settings.stat_label | escape }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if cta_text != blank %}
        <div class="sustainability-stats__cta">
          <a
            {% if section.settings.cta_link != blank %}href="{{ section.settings.cta_link }}"{% endif %}
            class="button button-primary"
          >
            {{ cta_text | escape }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .sustainability-stats {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
  }

  .sustainability-stats__wrapper {
    position: relative;
    overflow: hidden;
  }

  .sustainability-stats__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .sustainability-stats__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sustainability-stats__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgba(0, 0, 0, var(--overlay-opacity, 0.4));
  }

  .sustainability-stats__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-block: 48px;
    text-align: center;
  }

  .sustainability-stats__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 2rem;
    line-height: 2.5rem;
    margin: 0;
    color: #ffffff;
  }

  .sustainability-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .sustainability-stats__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }

    .sustainability-stats__content {
      padding-block: 64px;
    }
  }

  .sustainability-stats__card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(4px);
  }

  .sustainability-stats__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sustainability-stats__icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sustainability-stats__number {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 2rem;
    line-height: 2.5rem;
    color: #ffffff;
    margin: 0;
  }

  .sustainability-stats__label {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .sustainability-stats__cta {
    margin-block-start: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.sustainability_stats",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.background_image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Sustainability"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:settings.cta_text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:settings.cta_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-6"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "t:settings.stat_number",
          "default": "0"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "t:settings.stat_label",
          "default": "Description"
        },
        {
          "type": "image_picker",
          "id": "stat_icon",
          "label": "t:settings.icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.sustainability_stats",
      "settings": {
        "heading": "Sustainability"
      },
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "stat_number": "37,166.62g",
            "stat_label": "plastic bottles recycled to date"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_number": "12",
            "stat_label": "sustainable materials used"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_number": "45+",
            "stat_label": "community partners"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat_number": "1.2M",
            "stat_label": "pounds of ocean waste removed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
