{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
%}

<div
  id="section-{{ section.id }}"
  class="community-gallery color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="community-gallery__container page-width">
    <div class="community-gallery__header">
      {% if heading != blank %}
        <h2 class="community-gallery__heading">{{ heading | escape }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="community-gallery__subheading">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="community-gallery__link">
              {{ subheading | escape }}
            </a>
          {% else %}
            {{ subheading | escape }}
          {% endif %}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="community-gallery__grid">
        {% for block in section.blocks %}
          {% if block.type == 'gallery-image' %}
            <div class="community-gallery__item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    sizes: '(min-width: 990px) 16vw, 33vw',
                    widths: '165,220,330,440,550',
                    loading: 'lazy',
                    class: 'community-gallery__image',
                    alt: block.settings.image.alt
                }}
              {% else %}
                <div class="community-gallery__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'community-gallery__placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .community-gallery {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
  }

  .community-gallery__container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .community-gallery__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .community-gallery__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.5rem;
    line-height: 2rem;
    margin: 0;
    color: var(--color-foreground-heading);
  }

  .community-gallery__subheading {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-style: italic;
    margin: 0;
    color: var(--color-foreground);
  }

  .community-gallery__link {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .community-gallery__link:hover {
    opacity: 0.7;
  }

  .community-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  @media screen and (min-width: 990px) {
    .community-gallery__heading {
      font-size: 2rem;
      line-height: 2.5rem;
    }

    .community-gallery__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .community-gallery__item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .community-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .community-gallery__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .community-gallery__placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.community_gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Join the Fair Harbor Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Follow us on Instagram @FairHarborClothing"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:settings.instagram_url"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "gallery-image",
      "name": "Image",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.community_gallery",
      "settings": {
        "heading": "Join the Fair Harbor Community",
        "subheading": "Follow us on Instagram @FairHarborClothing"
      },
      "blocks": [
        { "type": "gallery-image" },
        { "type": "gallery-image" },
        { "type": "gallery-image" },
        { "type": "gallery-image" },
        { "type": "gallery-image" },
        { "type": "gallery-image" }
      ]
    }
  ]
}
{% endschema %}
